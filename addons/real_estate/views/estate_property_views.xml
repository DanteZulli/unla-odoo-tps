<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Propiedades</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" />
                <field name="tag_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_cancel"
                        string="Cancelar"
                        type="object"
                        invisible="state not in ['new', 'offer_received']"
                    />
                    <button
                        name="action_sold"
                        string="Marcar como vendida"
                        type="object"
                        invisible="state in ['sold', 'canceled']"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Vendida"
                        bg_color="bg-success"
                        invisible="state != 'sold'"
                    />
                    <h1>
                        <field name="name" placeholder="Nombre propiedad" />
                    </h1>
                    <field name="tag_ids" widget="many2many_tags" />
                    <div>
                        <button
                            name="action_remove_tags"
                            string="Sacar etiquetas"
                            type="object"
                        />
                        <button
                            name="action_load_all_tags"
                            string="Cargar todas las etiquetas"
                            type="object"
                        />
                        <button
                            name="action_new_tag"
                            string="A estrenar"
                            type="object"
                        />
                    </div>
                    <group>
                        <group>
                            <field name="property_type_id" />
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="selling_price" />
                            <field name="best_offer" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="description" />
                            <group>
                                <group>
                                    <field name="bedrooms" />
                                    <field name="living_area" />
                                    <field name="facades" />
                                    <field name="garage" />
                                </group>
                                <group>
                                    <field name="garden" />
                                    <field name="garden_area" />
                                    <field
                                        name="garden_orientation"
                                    />
                                    <field name="total_area" />
                                </group>
                            </group>
                        </page>
                        <page string="Más info.">
                            <group>
                                <field name="buyer_id" />
                                <field name="salesman_id" />
                            </group>
                        </page>
                        <page string="Ofertas">
                            <button
                                name="action_generate_offer"
                                string="Generar oferta automática"
                                type="object"
                            />
                            <field name="offer_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_estate_property_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="postcode" />
                <field name="expected_price" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="facades" />
                <filter
                    name="my_properties"
                    string="Mis propiedades"
                    domain="[('create_uid', '=', uid)]"
                />
                <filter
                    name="available"
                    string="Disponibles"
                    domain="[('state', 'in', ['new', 'offer_received'])]"
                />
                <group>
                    <filter
                        name="groupby_create_uid"
                        string="Creador"
                        context="{'group_by': 'create_uid'}"
                    />
                    <filter
                        name="groupby_create_month"
                        string="Mes de creación"
                        context="{'group_by': 'create_date:month'}"
                    />
                    <filter
                        name="groupby_postcode"
                        string="Código postal"
                        context="{'group_by': 'postcode'}"
                    />
                    <filter
                        name="groupby_state"
                        string="Estado"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
</odoo>
